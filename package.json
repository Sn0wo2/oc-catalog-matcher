{
  "name": "oc-catalog-matcher",
  "description": "Stop hand-writing OpenCode2 model metadata",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.1",
    "@opencode/core": "2.1.4",
    "@opencode/plugin": "2.1.4",
    "dice-coefficient": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2"
  }
}
