{
  "name": "oc-catalog-matcher",
  "version": "0.0.0",
  "description": "Stop hand-writing OpenCode2 model metadata",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/oc-catalog-matcher.git"
  },
  "packageManager": "bun@1.4.4",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@opencode/core": "2.1.4",
    "@opencode/plugin": "2.1.4",
    "dice-coefficient": "^2.1.1",
    "es-toolkit": "^1.53.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "4.0.33",
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "zod@4.1.8": "4.6.7",
    "zod@^3.25.76": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
